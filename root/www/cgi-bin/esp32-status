#!/bin/sh

# Read-only OpenWrt status endpoint for ESP32-C6.
# Install as /www/cgi-bin/esp32-status and keep it executable (chmod 755).

export LC_ALL=C
# Disable pathname expansion for UCI lists and query-string parsing.
set -f
. /lib/functions.sh
config_load esp32monitor
config_get ENABLED main enabled 0
config_get API_TOKEN main api_token ''
config_get ALLOW_QUERY_TOKEN main allow_query_token 1

reply_error() {
    printf 'Status: %s\r\n' "$1"
    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-store\r\n\r\n'
    printf '{"ok":false,"message":"%s"}\n' "$2"
    exit 0
}

[ "${REQUEST_METHOD:-GET}" = "GET" ] || reply_error "405 Method Not Allowed" "GET only"
[ "$ENABLED" = "1" ] || reply_error "503 Service Unavailable" "endpoint disabled"
REQUEST_TOKEN="${HTTP_X_API_TOKEN:-}"
if [ -z "$REQUEST_TOKEN" ] && [ "$ALLOW_QUERY_TOKEN" = "1" ]; then
    old_ifs="$IFS"
    IFS='&'
    for query_part in ${QUERY_STRING:-}; do
        case "$query_part" in
            token=*) REQUEST_TOKEN="${query_part#token=}" ;;
        esac
    done
    IFS="$old_ifs"
fi
[ -n "$API_TOKEN" ] && [ "$REQUEST_TOKEN" = "$API_TOKEN" ] || reply_error "401 Unauthorized" "invalid token"
# Permit only URL-safe tokens, also when configured directly with UCI.
case "$API_TOKEN" in *[!A-Za-z0-9_-]*) reply_error "503 Service Unavailable" "invalid token configuration" ;; esac

# Read once: metadata and payload must belong to the same published inode.
SNAPSHOT="$(cat /tmp/esp32monitor/snapshot.json 2>/dev/null)" || reply_error "503 Service Unavailable" "snapshot unavailable"
END_MS="$(printf '%s' "$SNAPSHOT" | jsonfilter -e '@.sample_end_ms')"
case "$END_MS" in ''|*[!0-9]*) reply_error "503 Service Unavailable" "invalid snapshot" ;; esac
AGE="$(awk -v stamp="$END_MS" '{ printf "%.0f", $1*1000-stamp }' /proc/uptime)"
FRESHNESS="$(awk -v age="$AGE" 'BEGIN { printf "\"age_ms\":%.0f,\"stale\":%s", age<0 ? 0 : age, (age<0 || age>3000) ? "true" : "false" }')"
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
printf '{%s,%s\n' "$FRESHNESS" "${SNAPSHOT#\{}"
