#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
start_service() {
    config_load esp32monitor
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/esp32monitor-collector
    procd_set_param respawn
    procd_set_param file /etc/config/esp32monitor
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    rm -f /tmp/esp32monitor/snapshot.json
}
reload_service() {
    stop
    start
}
service_triggers() {
    procd_add_reload_trigger esp32monitor
}
